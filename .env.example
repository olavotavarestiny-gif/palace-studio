# Ligação à base PostgreSQL existente. Obrigatória em produção e no Docker Compose.
# Dentro do Render: Internal Database URL, na mesma conta e região da base.
# Fora do Render, incluindo Vercel e este computador: External Database URL com sslmode=verify-full.
# Sem esta variável, apenas o desenvolvimento usa PostgreSQL PGlite local.
DATABASE_URL=
# Endereço provisório do Palace Studio; pode ser alterado depois do contrato.
PUBLIC_URL=https://palacelounge.mazanga.digital
# Pasta privada para cópias locais; ignorada para imagens na Vercel, que usa media_files.
# Sem DATABASE_URL, também contém o PostgreSQL local em desenvolvimento.
DATA_DIR=./data
# Opcional: apenas para a criação inicial através da página /setup.
# Gere com: openssl rand -hex 32. Remova depois de criar o administrador.
SETUP_TOKEN=
# Opcional: website e contacto oficiais podem ser definidos na aplicação.
# Integração de reservas: mesmo segredo privado no servidor do website e no Studio.
# Gere com openssl rand -hex 32. Nunca utilize um prefixo NEXT_PUBLIC_ neste segredo.
PALACE_RESERVATION_SECRET=
# Manutenção manual de privacidade; por omissão, apenas pré-visualiza os candidatos.
CRM_RETENTION_MONTHS=24
